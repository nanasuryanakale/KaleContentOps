<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <security>
        <authentication>
          <!--
            Root-cause guard (production issue: every request auto-authenticated as the
            hosting account "WIN8068\11330411"):
            - IIS Basic Authentication must be OFF: it challenged all requests (401 +
              WWW-Authenticate: Basic) before ASP.NET Core ran, and browsers replayed the
              hosting credentials automatically, bypassing ASP.NET Core Identity.
            - Windows Authentication must be OFF: the app has its own Identity auth.
            - Anonymous must be ON: unauthenticated requests reach the app so the
              fallback policy (RequireAuthenticatedUser) can challenge to /Account/Login.
            If SmarterASP locks these sections (HTTP 500.19 after deploy), remove this
            <security> block and disable Basic Authentication via the SmarterASP panel.
          -->
          <basicAuthentication enabled="false" />
          <anonymousAuthentication enabled="true" />
          <windowsAuthentication enabled="false" />
        </authentication>
      </security>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" forwardWindowsAuthToken="false" hostingModel="inprocess" />
      <!-- forwardWindowsAuthToken="false": never hand IIS-authenticated Windows tokens
           to the app, so HttpContext.User is built exclusively by ASP.NET Core Identity. -->
    </system.webServer>
  </location>
</configuration>
