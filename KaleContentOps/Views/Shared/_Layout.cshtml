<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KaleContentOps</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth-ui.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="topbar">
        <div class="topbar-left">
            <span class="app-title">KALE Content Ops</span>
        </div>
        @if (User.Identity?.IsAuthenticated == true)
        {
            var displayName = User.FindFirst(KaleContentOps.Security.AuthConstants.DisplayNameClaimType)?.Value;
            if (string.IsNullOrWhiteSpace(displayName)) { displayName = User.Identity?.Name; }
            <div class="topbar-right topbar-user">
                <span class="topbar-username">@displayName</span>
                <form asp-controller="Account" asp-action="Logout" method="post" class="topbar-logout-form">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-light topbar-logout">Logout</button>
                </form>
            </div>
        }
    </div>

    @await Html.PartialAsync("_Sidebar")

    <main class="app-main">
        <div class="container-fluid">
            @RenderBody()
        </div>
    </main>

    <footer class="app-footer">
        <div class="container-fluid">
            <div class="footer-left text-center">&copy; 2026 - KaleContentOps</div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
