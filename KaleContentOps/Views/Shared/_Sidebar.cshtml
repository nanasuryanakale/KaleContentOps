@* Reusable sidebar partial *@
@using KaleContentOps.Security
@{
    // Hide menu items the current user has no permission for.
    bool HasPermission(string permission) =>
        User.HasClaim(AuthConstants.PermissionClaimType, permission);

    var canViewTarget = HasPermission(AuthConstants.Permissions.TargetView);
    var canViewHistory = HasPermission(AuthConstants.Permissions.TargetHistoryView);
    var canViewContentLog = canViewTarget || canViewHistory;

    // ADMIN section (Admin Management MVP): each item is gated by its own permission,
    // and every admin screen re-checks the same permission server-side.
    var canAdminTikTok = HasPermission(AuthConstants.Permissions.TikTokAdminView);
    var canViewUsers = HasPermission(AuthConstants.Permissions.UserView);
    var canManageRolePerms = HasPermission(AuthConstants.Permissions.RolePermissionManage);
    var canSeeAdminSection = canAdminTikTok || canViewUsers || canManageRolePerms;
    var activeController = ViewContext.RouteData.Values["controller"] as string;
}
<aside class="app-sidebar">
    <div class="brand">
        <div class="brand-icon">K</div>
        <div class="brand-text">
            <div class="title">KALE Content Ops</div>
            <div class="subtitle">TikTok · Content Log</div>
        </div>
    </div>

    <nav class="menu">
        <div class="menu-section">TIKTOK CONTENT</div>
        <ul class="nav flex-column">
            @if (canViewContentLog)
            {
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"] as string == "ContentLog" ? "active" : "")" asp-controller="ContentLog" asp-action="Index">
                    <span class="nav-icon" aria-hidden="true">
                        <!-- list / table icon -->
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.5" />
                            <path d="M7 9H17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                            <path d="M7 13H13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                        </svg>
                    </span>
                    <span class="nav-text">Content Log</span>
                </a>
            </li>
            }
            <li class="nav-item"><a class="nav-link @(ViewContext.RouteData.Values["controller"] as string == "DailySummary" ? "active" : "")" asp-controller="DailySummary" asp-action="Index"><span class="nav-icon" aria-hidden="true">
                        <!-- calendar icon -->
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <rect x="3" y="5" width="18" height="16" rx="2" stroke="currentColor" stroke-width="1.2" />
                            <path d="M16 3V7" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
                            <path d="M8 3V7" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
                        </svg>
                    </span> <span class="nav-text">Daily Summary</span></a></li>
            @if (canViewTarget)
            {
            <li class="nav-item"><a class="nav-link @(ViewContext.RouteData.Values["controller"] as string == "Targets" ? "active" : "")" asp-controller="Targets" asp-action="Index"><span class="nav-icon" aria-hidden="true">
                        <!-- target icon -->
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.2" />
                            <circle cx="12" cy="12" r="7" stroke="currentColor" stroke-width="1.2" />
                        </svg>
                    </span> <span class="nav-text">Targets</span></a></li>
            }
            <li class="nav-item"><a class="nav-link @(ViewContext.RouteData.Values["controller"] as string == "WinningContent" ? "active" : "")" asp-controller="WinningContent" asp-action="Index"><span class="nav-icon" aria-hidden="true">
                        <!-- star / trophy icon -->
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M12 2l2.6 5.3L20 9l-4 3.6L17 20l-5-2.6L7 20l1-7.4L4 9l5.4-1.7L12 2z" stroke="currentColor" stroke-width="0.8" fill="none" />
                        </svg>
                    </span> <span class="nav-text">Winning Content</span></a></li>
            <li class="nav-item"><a class="nav-link" href="#"><span class="nav-icon" aria-hidden="true">
                        <!-- team icon -->
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M16 11c1.7 0 3-1.3 3-3s-1.3-3-3-3-3 1.3-3 3 1.3 3 3 3zM8 11c1.7 0 3-1.3 3-3S9.7 5 8 5 5 6.3 5 8s1.3 3 3 3zM4 18c0-2.2 3.6-3.5 6-3.5s6 1.3 6 3.5v1H4v-1z" stroke="currentColor" stroke-width="0.9" fill="none" />
                        </svg>
                    </span> <span class="nav-text">Team Performance</span></a></li>
        </ul>

        @if (canSeeAdminSection)
        {
        <div class="menu-section">ADMIN</div>
        <ul class="nav flex-column">
            @if (canAdminTikTok)
            {
            <li class="nav-item"><a class="nav-link @(activeController == "TikTokAdmin" ? "active" : "")" asp-controller="TikTokAdmin" asp-action="Index"><span class="nav-icon" aria-hidden="true">
                        <!-- sync icon -->
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M21 12a9 9 0 1 1-3-6.7" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
                            <path d="M21 3v6h-6" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </span> <span class="nav-text">Admin TikTok</span></a></li>
            }
            @if (canViewUsers)
            {
            <li class="nav-item"><a class="nav-link @(activeController == "AdminUsers" ? "active" : "")" asp-controller="AdminUsers" asp-action="Index"><span class="nav-icon" aria-hidden="true">
                        <!-- user icon -->
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.2" />
                            <path d="M4 20c0-3.3 3.6-5 8-5s8 1.7 8 5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
                        </svg>
                    </span> <span class="nav-text">Master User</span></a></li>
            }
            @if (canManageRolePerms)
            {
            <li class="nav-item"><a class="nav-link @(activeController == "AdminRoles" ? "active" : "")" asp-controller="AdminRoles" asp-action="Index"><span class="nav-icon" aria-hidden="true">
                        <!-- shield icon -->
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M12 3l8 3v6c0 4.4-3.2 7.7-8 9-4.8-1.3-8-4.6-8-9V6l8-3z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" />
                            <path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </span> <span class="nav-text">Master Role &amp; Permission</span></a></li>
            }
        </ul>
        }

        <div class="menu-section">CREATIVE PERFORMANCE</div>
        <ul class="nav flex-column">
            <li class="nav-item"><a class="nav-link menu-chart" href="#">Daily</a></li>
            <li class="nav-item"><a class="nav-link menu-chart" href="#">Weekly</a></li>
            <li class="nav-item"><a class="nav-link menu-chart" href="#">Monthly</a></li>
        </ul>
    </nav>

    @await Html.PartialAsync("_Footer")
</aside>
