@model KaleContentOps.ViewModels.MasterUserPageViewModel
@using KaleContentOps.Security
@{
    ViewData["Title"] = "Master User";
    var canManage = User.HasClaim(AuthConstants.PermissionClaimType, AuthConstants.Permissions.UserManage);
}

<link rel="stylesheet" href="~/css/admin.css" />

<div class="content-page admin-page">
    <header class="summary-header">
        <div class="summary-title">
            <h1>Master User</h1>
            <p>Kelola user internal Kale: role, status aktif, dan password (di-reset lewat UserManager).</p>
        </div>
        @if (canManage)
        {
            <div class="header-anchor">
                <button type="button" class="button-primary" id="btnNewUser">+ User Baru</button>
            </div>
        }
    </header>

    @* Visible page-level feedback for table actions (e.g. deactivation rejected by the
       last-admin safeguard). Reuses the existing .admin-error style - no new framework. *@
    @if (canManage)
    {
        <div class="admin-error" id="userActionError" hidden></div>
    }

    <section class="table-card admin-card">
        <div class="table-scroll">
            <table class="admin-table" id="usersTable">
                <thead>
                    <tr>
                        <th>USERNAME</th>
                        <th>NAMA</th>
                        <th>EMAIL</th>
                        <th>ROLE</th>
                        <th>STATUS</th>
                        <th>LAST LOGIN</th>
                        <th>DIBUAT</th>
                        @if (canManage)
                        {
                            <th class="actions-col">AKSI</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model.Users)
                    {
                        <tr data-user="@u.Id" data-username="@u.UserName" data-displayname="@u.DisplayName" data-email="@u.Email" data-role="@u.Role" data-active="@u.IsActive">
                            <td class="mono">@u.UserName</td>
                            <td>@u.DisplayName</td>
                            <td class="muted-cell">@(string.IsNullOrWhiteSpace(u.Email) ? "-" : u.Email)</td>
                            <td><span class="role-badge">@u.Role</span></td>
                            <td>
                                @if (u.IsActive)
                                {
                                    <span class="status-pill status-achieved">Aktif</span>
                                }
                                else
                                {
                                    <span class="status-pill status-below">Nonaktif</span>
                                }
                            </td>
                            <td class="muted-cell">@(u.LastLoginAt?.ToString("dd-MM-yyyy HH:mm") ?? "Belum pernah")</td>
                            <td class="muted-cell">@u.CreatedAt.ToString("dd-MM-yyyy")</td>
                            @if (canManage)
                            {
                                <td class="actions-col">
                                    <button type="button" class="admin-action js-edit" data-id="@u.Id">Edit</button>
                                    <button type="button" class="admin-action js-password" data-id="@u.Id">Password</button>
                                    @if (u.IsActive)
                                    {
                                        <button type="button" class="admin-action danger js-deactivate" data-id="@u.Id">Nonaktifkan</button>
                                    }
                                    else
                                    {
                                        <button type="button" class="admin-action js-activate" data-id="@u.Id">Aktifkan</button>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    @if (canManage)
    {
        <section class="popover-panel admin-modal" id="userModal" hidden>
            <div class="date-picker-topline">
                <div>
                    <strong id="userModalTitle">User Baru</strong>
                    <small id="userModalSubtitle">Buat user internal dengan role dan password awal.</small>
                </div>
                <button type="button" class="close-button" id="closeUserModal" aria-label="Close">×</button>
            </div>

            <div class="admin-form">
                <label class="admin-field">
                    <span>Username</span>
                    <input type="text" id="fUserName" autocomplete="off" />
                </label>
                <label class="admin-field">
                    <span>Display Name</span>
                    <input type="text" id="fDisplayName" autocomplete="off" />
                </label>
                <label class="admin-field">
                    <span>Email</span>
                    <input type="email" id="fEmail" autocomplete="off" />
                </label>
                <label class="admin-field">
                    <span>Role</span>
                    <select id="fRole">
                        @foreach (var r in Model.AssignableRoles)
                        {
                            <option value="@r.Name">@r.Name</option>
                        }
                    </select>
                </label>
                <label class="admin-field" id="passwordField">
                    <span>Password awal</span>
                    <input type="password" id="fPassword" autocomplete="new-password" />
                    <small>Min. 10 karakter, huruf besar/kecil, angka, simbol (kebijakan Identity).</small>
                </label>
                <label class="admin-field" id="newPasswordField" hidden>
                    <span>Password baru (opsional)</span>
                    <input type="password" id="fNewPassword" autocomplete="new-password" />
                    <small>Isi hanya jika ingin reset password. Min. 10 karakter, huruf besar/kecil, angka, simbol.</small>
                </label>
                <label class="admin-check">
                    <input type="checkbox" id="fActive" /> Aktif (user nonaktif tidak dapat login)
                </label>
                <div class="admin-error" id="userModalError" hidden></div>
                <div class="admin-form-actions">
                    <button type="button" class="button-secondary" id="cancelUserModal">Batal</button>
                    <button type="button" class="button-primary" id="submitUserModal">Simpan</button>
                </div>
            </div>
        </section>

        @Html.AntiForgeryToken()
    }
</div>

@section Scripts {
<script src="~/js/admin-users.js"></script>
}
