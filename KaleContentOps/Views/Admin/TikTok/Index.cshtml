@model IEnumerable<KaleContentOps.Models.TikTokShop>
@{
    ViewData["Title"] = "TikTok Admin";
}

<link rel="stylesheet" href="~/css/calendar-popup.css" />
<link rel="stylesheet" href="~/css/admin-tiktok.css" />

<div class="container admin-tiktok-page">
    <h2>TikTok Administration</h2>

    @if (TempData["TikTokSyncMessage"] != null)
    {
        <div class="alert alert-success">@TempData["TikTokSyncMessage"]</div>
    }
    @if (TempData["TikTokSyncError"] != null)
    {
        <div class="alert alert-danger">@TempData["TikTokSyncError"]</div>
    }
    @if (TempData["TikTokSyncResult"] != null)
    {
        <div class="alert alert-info">@TempData["TikTokSyncResult"]</div>
    }
    @if (TempData["TikTokSyncPerShopErrors"] != null)
    {
        <pre class="text-danger">@TempData["TikTokSyncPerShopErrors"]</pre>
    }

    <div class="mb-3">
        <form asp-action="SyncAuthorizedShops" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-primary">Sync Authorized Shops</button>
        </form>
    </div>

    <div class="mb-3">
        <form asp-action="SyncVideos" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-success">Sync TikTok Videos</button>
        </form>
    </div>

    <div class="mb-3">
        <form asp-action="SyncVideoDetails" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-info">Sync Video Details ( Likes, Comments, Share, New Followers )</button>
            <small class="text-muted">Enriches up to 20 videos per shop per run. Rate-limit safe via shared retry/backoff.</small>
        </form>
    </div>

    <!-- Single-video sync card: independent of the shops table -->
    <div class="mb-3">
        <div class="card p-3">
            <h5>Sync Detail — Single Video</h5>
            <form asp-action="SyncVideoDetailsSingle" method="post" class="batch-inline-form">
                @Html.AntiForgeryToken()
                <label for="contentLogId" class="sr-only">ContentLog ID</label>
                <input type="number" name="contentLogId" id="contentLogId" placeholder="Contoh: 1" class="form-control form-control-sm batch-inline-input" />
                <button type="submit" class="btn btn-sm btn-primary">Sync Detail</button>
                <div class="text-muted batch-inline-note">Masukkan ContentLog ID untuk mengambil detail analytics dari satu video.</div>
            </form>
        </div>
    </div>

    <div class="mb-3">
        <div class="card p-3">
            <h5>Controlled Job #1 — Single Pending Item Test</h5>
            <p class="text-muted">Read-only preview first. Execution requires an explicit confirmation and is rejected while the batch worker is enabled.</p>
            <button type="button" class="btn btn-sm btn-outline-primary" id="controlledItemPreviewButton">Preview Job #1 Pending Item</button>
            <div id="controlledItemPreview" class="small mt-2"></div>
            <form id="controlledItemExecuteForm" method="post" action="@Url.Action("ControlledSingleItemExecute", "TikTokAdmin")" class="mt-2" style="display:none;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="jobId" id="controlledItemJobId" />
                <input type="hidden" name="itemId" id="controlledItemId" />
                <label class="form-check-label mb-2">
                    <input type="checkbox" class="form-check-input" id="controlledItemConfirm" required />
                    I confirm that exactly this item may be processed.
                </label>
                <button type="submit" class="btn btn-sm btn-warning">Execute Confirmed Single Item</button>
            </form>
        </div>
    </div>

    <!-- All-P1 bulk sync card -->
    <div class="mb-3">
        <div class="card p-3">
            <h5>Sync Detail — All Videos</h5>
            <div style="margin-top:8px;">
                <form asp-action="SyncVideoDetailsP1" method="post" class="batch-inline-form">
                    @Html.AntiForgeryToken()
                    <label class="sr-only" for="p1Limit">Batch size</label>
                    <input type="hidden" name="limit" value="10" />
                    <span class="form-control form-control-sm batch-inline-fixed">Batch size: 10</span>
                    <button type="submit" class="btn btn-sm btn-primary">Sync Detail — Next 10</button>
                </form>
                <div class="text-muted" style="margin-top:6px;">Mengambil analytics Details dan demographic untuk video yang masih belum ter-enrich. Proses berjalan maksimal 10 video per batch dan dapat dilanjutkan dengan menekan tombol kembali. Menggunakan kandidat P1 saat ini. Video yang berhasil akan otomatis keluar dari antrean P1.</div>
            </div>
        </div>
    </div>

    <!-- Persistent batch sync: date-range Sync Video Details (background job) -->
    <div class="mb-3">
        <div class="card p-3 batch-sync-card">
            <h5 class="batch-sync-title">Sync Video Details — Date Range (Background Job)</h5>
            <p class="batch-sync-note">
                Periode = <strong>TikTok Shop Video Performance Analytics period</strong> (<code>start_date_ge</code> … <code>end_date_lt</code>),
                <em>bukan</em> tanggal posting video (VideoPostTime). End Date bersifat <strong>inklusif</strong>.
                Job berjalan di background (ID dikumpulkan dulu, lalu detail diproses satu per satu).
            </p>
            <form id="batchSyncForm" method="post" action="@Url.Action("StartBatchSync", "TikTokAdmin")" class="batch-sync-form">
                @Html.AntiForgeryToken()
                <div class="batch-form-grid">
                    <div class="batch-field batch-field-shop">
                        <label class="batch-field-label" for="batchShopId">Authorized shop</label>
                        <select name="shopId" id="batchShopId" class="form-control form-control-sm" required>
                            <option value="">-- Pilih authorized shop --</option>
                            @foreach (var s in Model)
                            {
                                if (string.IsNullOrWhiteSpace(s.ShopCipher)) { continue; }
                                <option value="@s.Id">@(s.ShopName ?? s.ShopCode ?? s.ShopId ?? ("Shop #" + s.Id))</option>
                            }
                        </select>
                    </div>
                    <div class="batch-field batch-field-range">
                        <span class="batch-field-label">Periode analytics</span>
                        <!-- Anchor wraps the trigger + panel so the panel positions under the button
                             (same structure as Daily Summary's .header-anchor). -->
                        <div class="batch-date-anchor">
                        <button type="button" class="date-range-button" id="batchDateRangeButton" aria-expanded="false" aria-controls="batchDatePickerPanel">
                            <span class="calendar-icon" aria-hidden="true">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <rect x="3" y="5" width="18" height="16" rx="2" stroke="currentColor" stroke-width="1.4" />
                                    <path d="M16 3V7" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                                    <path d="M8 3V7" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                                </svg>
                            </span>
                            <strong id="batchDateRangeLabel">Pilih rentang</strong>
                            <small>GMT+7</small>
                        </button>

                        <!-- Shared range-calendar panel (same component/structure as Daily Summary) -->
                        <section class="popover-panel date-picker-panel" id="batchDatePickerPanel" hidden>
                            <div class="date-picker-topline">
                                <div>
                                    <strong id="batchPendingRangeLabel"></strong>
                                    <small>Pilih rentang periode analytics</small>
                                </div>
                                <button type="button" class="close-button" id="batchCloseDatePicker" aria-label="Close">×</button>
                            </div>
                            <div class="date-picker-body">
                                <div class="preset-list" id="batchPresetList">
                                    <div class="preset-title">PERIODE CEPAT</div>
                                    <button type="button" data-preset="today">Hari Ini</button>
                                    <button type="button" data-preset="yesterday">Kemarin</button>
                                    <button type="button" data-preset="7">1 Minggu Terakhir</button>
                                    <button type="button" data-preset="30">1 Bulan Terakhir</button>
                                    <button type="button" data-preset="90">3 Bulan Terakhir</button>
                                </div>
                                <div class="calendar-area">
                                    <div class="calendar-toolbar">
                                        <button type="button" id="batchPreviousMonth" aria-label="Previous month">‹</button>
                                        <strong id="batchCalendarTitle"></strong>
                                        <button type="button" id="batchNextMonth" aria-label="Next month">›</button>
                                    </div>
                                    <div class="calendar-grid" id="batchCalendarGrid"></div>
                                </div>
                            </div>
                            <div class="date-picker-actions">
                                <div class="date-picker-selected" id="batchDatePickerSelected"></div>
                                <div>
                                    <button type="button" class="button-secondary" id="batchCancelDatePicker">Batal</button>
                                    <button type="button" class="button-primary" id="batchApplyDatePicker">Terapkan</button>
                                </div>
                            </div>
                        </section>
                        </div>
                    </div>
                    <div class="batch-field batch-field-submit">
                        <button type="submit" class="btn btn-sm btn-primary" id="batchSyncButton">Sync Video Details</button>
                    </div>
                </div>

                <!-- Hidden inputs untuk form submission -->
                <input type="hidden" name="startDate" id="batchStartDate" />
                <input type="hidden" name="endDate" id="batchEndDate" />
            </form>
            <div id="batchSyncError" class="text-danger" style="margin-top: 6px; display: none;"></div>

            <!-- Live job status (polled) -->
            <div id="batchSyncStatus" style="margin-top: 10px; display: none;">
                <h6 style="margin-bottom: 4px;">Job #<span id="bsJobId"></span> — <span id="bsPhase" class="badge badge-info">Queued</span></h6>
                <div class="small">Shop: <span id="bsShop">-</span> &nbsp;|&nbsp; Periode: <span id="bsPeriod">-</span> &nbsp;|&nbsp; Halaman: <span id="bsPages">0</span></div>
                <div class="small">
                    Total ID: <strong id="bsTotal">0</strong> &nbsp;|&nbsp;
                    Pending: <span id="bsPending">0</span> &nbsp;|&nbsp;
                    Processing: <span id="bsProcessing">0</span> &nbsp;|&nbsp;
                    Succeeded: <span id="bsSucceeded">0</span> &nbsp;|&nbsp;
                    Failed: <span id="bsFailed">0</span> &nbsp;|&nbsp;
                    Tidak diproses: <span id="bsNotAttempted">0</span> &nbsp;|&nbsp;
                    Unclassified: <span id="bsUnclassified">0</span>
                </div>
                <div class="progress" style="height: 18px; margin-top: 6px;">
                    <div id="bsProgressBar" class="progress-bar" role="progressbar" style="width: 0%;">0%</div>
                </div>
                <div id="bsLastError" class="small text-danger" style="margin-top: 4px;"></div>
                <div id="bsNextAttempt" class="small text-muted"></div>
                <div id="bsFailedItems" class="small" style="margin-top: 4px;"></div>
            </div>
        </div>
    </div>

    <!-- Batch sync job history -->
    <div class="mb-3">
        <div class="card p-3">
            <h5 class="batch-sync-title">Riwayat Batch Sync</h5>
            <div class="table-responsive batch-history-scroll">
                <table class="table table-sm table-striped batch-history-table" id="batchHistoryTable">
                    <thead>
                        <tr>
                            <th>Job</th><th>Shop</th><th>Periode</th><th>Status</th>
                            <th>Found</th><th>Pending</th><th>Processing</th><th>Succeeded</th><th>Failed</th>
                            <th>Tidak diproses</th><th>Created</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>

    <h4>Authorized Shops</h4>
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>ShopCipher</th>
                    <th>ShopId</th>
                    <th>ShopCode</th>
                    <th>ShopName</th>
                    <th>Region</th>
                    <th>SellerType</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td>@s.Id</td>
                        <td>@s.ShopCipher</td>
                        <td>@s.ShopId</td>
                        <td>@s.ShopCode</td>
                        <td>@s.ShopName</td>
                        <td>@s.Region</td>
                        <td>@s.SellerType</td>
                        <td>
                            <!-- Shop-related actions only (single-video sync moved above) -->
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<script src="~/js/calendar-popup.js" asp-append-version="true"></script>
<script src="~/js/admin-tiktok-batch-sync.js" asp-append-version="true"></script>
<script>
(() => {
    const previewButton = document.getElementById('controlledItemPreviewButton');
    const preview = document.getElementById('controlledItemPreview');
    const form = document.getElementById('controlledItemExecuteForm');
    previewButton?.addEventListener('click', async () => {
        form.style.display = 'none';
        preview.textContent = 'Loading read-only preview...';
        const response = await fetch('@Url.Action("ControlledSingleItemPreview", "TikTokAdmin", new { jobId = 1 })');
        const result = await response.json();
        if (!result.isAvailable) {
            preview.textContent = result.error || 'No eligible Pending item.';
            return;
        }
        const p = result.preview;
        preview.textContent = `Job ${p.jobId}, item ${p.itemId}, video ${p.videoId}, status ${p.status}, period ${p.startDate} through ${p.endDateInclusive}, request end ${p.endDateExclusive}.`;
        document.getElementById('controlledItemJobId').value = p.jobId;
        document.getElementById('controlledItemId').value = p.itemId;
        form.style.display = 'block';
    });
})();
</script>
