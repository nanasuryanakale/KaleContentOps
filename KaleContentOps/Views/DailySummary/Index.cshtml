@model KaleContentOps.ViewModels.DailySummaryPageModel
@{
    ViewData["Title"] = "Daily Summary";
    var data = Model.Data;
}
<link rel="stylesheet" href="~/css/daily-summary.css" />

<div class="content-page daily-summary-page" data-start="@data.StartDate.ToString("yyyy-MM-dd")" data-end="@data.EndDate.ToString("yyyy-MM-dd")">
    <header class="summary-header">
        <div class="summary-title">
            <h1>Daily Summary</h1>
            <p>Jumlah konten &amp; total views per hari berdasarkan tanggal video diposting.</p>
        </div>
        <div class="header-anchor">
            <button type="button" class="date-range-button" id="dateRangeButton" aria-expanded="false" aria-controls="datePickerPanel">
                <span class="calendar-icon" aria-hidden="true">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <rect x="3" y="5" width="18" height="16" rx="2" stroke="currentColor" stroke-width="1.4" />
                        <path d="M16 3V7" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                        <path d="M8 3V7" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                    </svg>
                </span>
                <strong id="dateRangeLabel">@data.StartDate.ToString("dd/MM") - @data.EndDate.ToString("dd/MM")</strong>
                <small>GMT+7</small>
            </button>

            <section class="popover-panel date-picker-panel" id="datePickerPanel" hidden>
                <div class="date-picker-topline">
                    <div>
                        <strong id="pendingRangeLabel"></strong>
                        <small>Pilih rentang tanggal laporan</small>
                    </div>
                    <button type="button" class="close-button" id="closeDatePicker" aria-label="Close">×</button>
                </div>
                <div class="date-picker-body">
                    <div class="preset-list" id="presetList">
                        <div class="preset-title">PERIODE CEPAT</div>
                        <button type="button" data-preset="today">Hari Ini</button>
                        <button type="button" data-preset="yesterday">Kemarin</button>
                        <button type="button" data-preset="7">1 Minggu Terakhir</button>
                        <button type="button" data-preset="30">1 Bulan Terakhir</button>
                        <button type="button" data-preset="90">3 Bulan Terakhir</button>
                    </div>
                    <div class="calendar-area">
                        <div class="calendar-toolbar">
                            <button type="button" id="previousMonth" aria-label="Previous month">‹</button>
                            <strong id="calendarTitle"></strong>
                            <button type="button" id="nextMonth" aria-label="Next month">›</button>
                        </div>
                        <div class="calendar-grid" id="calendarGrid"></div>
                    </div>
                </div>
                <div class="date-picker-actions">
                    <div class="date-picker-selected" id="datePickerSelected"></div>
                    <div>
                        <button type="button" class="button-secondary" id="cancelDatePicker">Batal</button>
                        <button type="button" class="button-primary" id="applyDatePicker">Terapkan</button>
                    </div>
                </div>
            </section>
        </div>
    </header>

    <div class="daily-toolbar">
        <!-- Top row: controls (button, checkboxes, legend) -->
        <div class="toolbar-top">
            <div class="toolbar-left">
                <div class="toolbar-anchor">
                    <button type="button" class="toolbar-button" id="columnsButton" aria-expanded="false" aria-controls="columnPanel">
                        <span aria-hidden="true">▤</span> Kolom
                    </button>
                </div>
                <label class="check-control">
                    <input id="includeAutoGmv" type="checkbox" @(data.IncludeAutoGmvInTotal ? "checked" : null) />
                    Termasuk Auto GMV Live di kolom Total
                </label>
                <label class="check-control check-control-muted">
                    <input id="includeArchived" type="checkbox" @(data.IncludeArchived ? "checked" : null) />
                    Include Archived
                </label>
            </div>

            <div class="legend-row">
                <span><i class="category-dot kk"></i> Keranjang Kuning</span>
                <span><i class="category-dot nonkk"></i> Non-KK</span>
                <span><i class="category-dot autogmv"></i> Auto GMV Live</span>
            </div>
        </div>

        <!-- Second row: column filter card (kept out of the top row so it appears on its own line) -->
        <section class="popover-panel column-panel" id="columnPanel" hidden>
            <div class="popover-title">PILIH JENIS KONTEN YANG DITAMPILKAN</div>
            <div class="column-body">
                <div class="checkbox-row">
                    <label><input type="checkbox" data-column="nonkk" checked="@(Model.ShowNonKk ? "checked" : null)" /> Non-KK</label>
                    <label><input type="checkbox" data-column="kk" checked="@(Model.ShowKk ? "checked" : null)" /> Keranjang Kuning</label>
                    <label><input type="checkbox" data-column="autogmv" checked="@(Model.ShowAutoGmv ? "checked" : null)" /> Auto GMV Live</label>
                </div>
                <div class="column-note">Tiap jenis konten nampilin 2 kolom sekaligus (Jumlah Konten &amp; Total Views) — matching panel toggle di sheet rancangan baru.</div>
            </div>
        </section>
    </div>

    <section class="table-card daily-table-card mt-3">
        <div class="table-scroll">
            <table class="daily-summary-table">
                <thead>
                    <tr class="group-row">
                        <th class="index-column"></th>
                        <th class="date-column"></th>
                        <th class="group-total" colspan="2">TOTAL (NON-KK+KK)</th>
                        <th class="group-nonkk col-nonkk" colspan="2">NON-KK</th>
                        <th class="group-kk col-kk" colspan="2">KERANJANG KUNING</th>
                        <th class="group-autogmv col-autogmv" colspan="2">AUTO GMV LIVE</th>
                    </tr>
                    <tr class="column-row">
                        <th class="index-column">No</th>
                        <th class="date-column">Tanggal</th>
                        <th>Jumlah Konten</th><th>Total Views</th>
                        <th class="col-nonkk">Jumlah Konten</th><th class="col-nonkk">Total Views</th>
                        <th class="col-kk">Jumlah Konten</th><th class="col-kk">Total Views</th>
                        <th class="col-autogmv">Jumlah Konten</th><th class="col-autogmv">Total Views</th>
                    </tr>
                </thead>
                <tbody>
                @for (var i = 0; i < data.Rows.Count; i++)
                {
                    var row = data.Rows[i];
                    <tr>
                        <td class="index-column">@(i + 1)</td>
                        <td class="date-column">@row.Date.ToString("dd MMM yyyy")</td>
                        <td class="total-content @($"tgt-{row.TotalContentStatus}")" data-nonkk="@row.NonKkCount" data-kk="@row.KkCount" data-autogmv="@row.AutoGmvCount" data-total-content-target="@data.TotalDailyContentTarget">@row.TotalCount.ToString("N0")</td>
                        <td class="total-views number @($"tgt-{row.TotalViewsStatus}")" data-nonkk="@row.NonKkViews" data-kk="@row.KkViews" data-autogmv="@row.AutoGmvViews" data-total-views-target="@data.TotalDailyViewsTarget">@row.TotalViews.ToString("N0")</td>
                        <td class="col-nonkk @($"tgt-{row.NonKkContentStatus}")">@row.NonKkCount.ToString("N0")</td>
                        <td class="col-nonkk number @($"tgt-{row.NonKkViewsStatus}")">@row.NonKkViews.ToString("N0")</td>
                        <td class="col-kk @($"tgt-{row.KkContentStatus}")">@row.KkCount.ToString("N0")</td>
                        <td class="col-kk number @($"tgt-{row.KkViewsStatus}")">@row.KkViews.ToString("N0")</td>
                        <td class="col-autogmv">@row.AutoGmvCount.ToString("N0")</td>
                        <td class="col-autogmv number">@row.AutoGmvViews.ToString("N0")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>

    <div class="summary-layout">
        <section class="report-card summary-card">
            <div class="card-heading summary-card-heading">
                RINGKASAN · @data.StartDate.ToString("d MMM", new System.Globalization.CultureInfo("id-ID")).ToUpper()–@data.EndDate.ToString("d MMM yyyy", new System.Globalization.CultureInfo("id-ID")).ToUpper()
            </div>
            <div class="table-scroll">
                <table class="report-table summary-table">
                    <thead>
                        <tr>
                            <th>JENIS KONTEN</th>
                            <th>AVG KONTEN/HARI</th>
                            <th>AVG VIEWS/HARI</th>
                            <th>TOTAL KONTEN</th>
                            <th>TOTAL VIEWS</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model.TypeSummaries)
                    {
                        var dotClass = item.Code == "NON_KK" ? "nonkk" : item.Code == "KK" ? "kk" : "autogmv";
                        <tr>
                            <td class="col-jenis">
                                <span class="category-dot @dotClass"></span>
                                <strong>@item.Name</strong>
                            </td>
                            <td class="col-avg">@item.AvgContentPerDay.ToString("0.#", new System.Globalization.CultureInfo("id-ID"))</td>
                            <td class="col-avg">@item.AvgViewsPerDay.ToString("N0", new System.Globalization.CultureInfo("id-ID"))</td>
                            <td class="col-total">@item.TotalCount.ToString("N0")</td>
                            <td class="col-total">@item.TotalViews.ToString("N0")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="report-card composition-card">
            <div class="card-heading composition-card-heading">
                KOMPOSISI JENIS KONTEN · @data.StartDate.ToString("d MMM", new System.Globalization.CultureInfo("id-ID")).ToUpper()–@data.EndDate.ToString("d MMM yyyy", new System.Globalization.CultureInfo("id-ID")).ToUpper()
            </div>
    
            <div class="composition-content">
                <div class="donut" id="compositionDonut"></div>
                <div class="composition-legend">
                @foreach (var item in Model.Composition)
                {
                    var dotClass = item.Code == "NON_KK" ? "nonkk" : item.Code == "KK" ? "kk" : "autogmv";
                    <div>
                        <span><i class="category-dot @dotClass"></i>@item.Name</span>
                        <strong>@item.Percentage.ToString("N0")%</strong>
                    </div>
                }
                </div>
            </div>
        </section>
    </div>

    <section class="report-card target-card">
        <div class="card-heading">
            PENCAPAIAN VS TARGET · @data.StartDate.ToString("d MMM", new System.Globalization.CultureInfo("id-ID")).ToUpper()–@data.EndDate.ToString("d MMM yyyy", new System.Globalization.CultureInfo("id-ID")).ToUpper()
        </div>
        <div class="table-scroll">
            <table class="report-table target-table">
                <thead>
                    <tr>
                        <th>JENIS KONTEN</th>
                        <th>METRIK</th>
                        <th>TARGET PERIODE INI</th>
                        <th>ACTUAL</th>
                        <th>SELISIH</th>
                        <th>STATUS</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.TargetAchievements)
                {
                    var statusClass = item.Status == "achieved" ? "status-achieved" : "status-below";
                    var statusText = item.Status == "achieved" ? "Tercapai" : "Belum Tercapai";
                
                    // Menentukan warna titik berdasarkan nama konten
                    var dotClass = item.ContentTypeName.Contains("Non-KK") ? "nonkk" : (item.ContentTypeName.Contains("Keranjang Kuning") ? "kk" : "autogmv");
                
                    <tr>
                        <td>
                            <span class="category-dot @dotClass"></span>
                            @item.ContentTypeName
                        </td>
                        <td>@item.MetricName</td>
                        <td>@item.TargetPeriodValue.ToString("N0")</td>
                        <td>@item.ActualValue.ToString("N0")</td>
                        <td class="@(item.VarianceValue >= 0 ? "tgt-above" : "tgt-below")">@item.VarianceValue.ToString("+0;-0;0")</td>
                        <td><span class="status-pill @statusClass">@statusText</span></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>

    <aside class="info-note">
        <strong>Catatan perhitungan</strong>
        <span>Rentang tanggal yang dipilih menentukan periode target. Target periode dihitung berdasarkan jumlah hari kalender yang dipilih. Status merah berarti actual masih di bawah target harian; status hijau berarti target tercapai atau terlampaui. Views yang ditampilkan adalah akumulasi terbaru.</span>
    </aside>
</div>

@section Scripts {
<script>
(() => {
    const page = document.querySelector('.daily-summary-page');
    const rangeButton = document.getElementById('dateRangeButton');
    const datePanel = document.getElementById('datePickerPanel');
    const columnPanel = document.getElementById('columnPanel');
    const columnsButton = document.getElementById('columnsButton');
    const appliedStart = page.dataset.start;
    const appliedEnd = page.dataset.end;
    let pendingStart = appliedStart;
    let pendingEnd = appliedEnd;
    let calendarMonth = new Date(`${appliedStart}T00:00:00`);
    calendarMonth.setDate(1);

    const parseDate = value => new Date(`${value}T00:00:00`);
    const isoDate = date => {
        const year = date.getFullYear();
        const month = String(date.getMonth() + 1).padStart(2, '0');
        const day = String(date.getDate()).padStart(2, '0');
        return `${year}-${month}-${day}`;
    };
    const formatDate = value => parseDate(value).toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' });
    const formatNumber = value => Number(value || 0).toLocaleString('id-ID');

    function setPanel(panel, button, open) {
        panel.hidden = !open;
        button.setAttribute('aria-expanded', open ? 'true' : 'false');
    }

    function renderPendingLabel() {
        const label = document.getElementById('pendingRangeLabel');
        if (pendingStart && pendingEnd) label.textContent = `${formatDate(pendingStart)} - ${formatDate(pendingEnd)}`;
        else if (pendingStart && !pendingEnd) label.textContent = `${formatDate(pendingStart)} - ...`;
        else label.textContent = 'Pilih rentang tanggal';
        // footer short label
        const footer = document.getElementById('datePickerSelected');
        if (footer) {
            if (pendingStart && pendingEnd) footer.textContent = `${formatDate(pendingStart)} - ${formatDate(pendingEnd)}`;
            else if (pendingStart) footer.textContent = `${formatDate(pendingStart)} - ...`;
            else footer.textContent = '';
        }
    }

    function renderCalendar() {
        const grid = document.getElementById('calendarGrid');
        const monthNames = ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'];
        const firstMonth = new Date(calendarMonth);
        const secondMonth = new Date(calendarMonth);
        secondMonth.setMonth(secondMonth.getMonth() + 1);
        document.getElementById('calendarTitle').textContent = `${monthNames[firstMonth.getMonth()]} ${firstMonth.getFullYear()} · ${monthNames[secondMonth.getMonth()]} ${secondMonth.getFullYear()}`;
        grid.innerHTML = [firstMonth, secondMonth].map(renderMonth).join('');
        grid.querySelectorAll('[data-date]').forEach(day => day.addEventListener('click', event => {
            // The click re-renders the calendar grid, detaching this button from the DOM before
            // the event finishes bubbling; stop it here so the click-outside handler cannot close the panel.
            event.stopPropagation();
            const selected = day.dataset.date;
            // Compare as timestamps
            const selTime = new Date(selected).getTime();
            const hasStart = !!pendingStart;
            const hasEnd = !!pendingEnd;

            if (!hasStart) {
                // CASE 1: no start
                pendingStart = selected;
                pendingEnd = null;
            } else if (hasStart && !hasEnd) {
                // CASE 2: have start only
                const startTime = new Date(pendingStart).getTime();
                if (selTime >= startTime) {
                    pendingEnd = selected;
                } else {
                    // selected before start -> treat as new start
                    pendingStart = selected;
                    pendingEnd = null;
                }
            } else {
                // CASE 3: both exist -> start new range
                pendingStart = selected;
                pendingEnd = null;
            }

            renderPendingLabel();
            renderCalendar();
        }));
    }

    function renderMonth(month) {
        const weekdays = ['Sn', 'Sl', 'Rb', 'Km', 'Jm', 'Sb', 'Mg'];
        const firstDay = new Date(month.getFullYear(), month.getMonth(), 1);
        const daysInMonth = new Date(month.getFullYear(), month.getMonth() + 1, 0).getDate();
        let html = `<div class="calendar-month"><strong>${firstDay.toLocaleDateString('id-ID', { month: 'long', year: 'numeric' })}</strong><div class="weekday-row">${weekdays.map(x => `<span>${x}</span>`).join('')}</div><div class="days-grid">`;
        const offset = (firstDay.getDay() + 6) % 7;
        for (let i = 0; i < offset; i++) html += '<span class="empty-day"></span>';
        for (let day = 1; day <= daysInMonth; day++) {
            const value = isoDate(new Date(month.getFullYear(), month.getMonth(), day));
            const selected = (pendingStart && value === pendingStart) || (pendingEnd && value === pendingEnd);
            const inRange = pendingStart && pendingEnd && (new Date(value).getTime() > new Date(pendingStart).getTime() && new Date(value).getTime() < new Date(pendingEnd).getTime());
            html += `<button type="button" class="calendar-day${selected ? ' selected' : ''}${inRange ? ' in-range' : ''}" data-date="${value}">${day}</button>`;
        }
        return html + '</div></div>';
    }

    function updateTotals() {
        const includeAuto = document.getElementById('includeAutoGmv').checked;
        document.querySelectorAll('.total-content').forEach(cell => {
            const nonkk = Number(cell.dataset.nonkk) || 0;
            const kk = Number(cell.dataset.kk) || 0;
            const autogmv = Number(cell.dataset.autogmv) || 0;
            const value = nonkk + kk + (includeAuto ? autogmv : 0);
            cell.textContent = formatNumber(value);

            // Update status class to match server-side GetStatus (actual >= target => above)
            const target = Number(cell.dataset.totalContentTarget) || 0;
            cell.classList.remove('tgt-above', 'tgt-below');
            const cls = value >= target ? 'tgt-above' : 'tgt-below';
            cell.classList.add(cls);
        });

        document.querySelectorAll('.total-views').forEach(cell => {
            const nonkk = Number(cell.dataset.nonkk) || 0;
            const kk = Number(cell.dataset.kk) || 0;
            const autogmv = Number(cell.dataset.autogmv) || 0;
            const value = nonkk + kk + (includeAuto ? autogmv : 0);
            cell.textContent = formatNumber(value);

            const target = Number(cell.dataset.totalViewsTarget) || 0;
            cell.classList.remove('tgt-above', 'tgt-below');
            const cls = value >= target ? 'tgt-above' : 'tgt-below';
            cell.classList.add(cls);
        });
    }

    function getColumnState() {
        const state = { nonkk: true, kk: true, autogmv: true };
        document.querySelectorAll('[data-column]').forEach(input => { state[input.dataset.column] = input.checked; });
        return state;
    }

    function buildReloadUrl() {
        const url = new URL(window.location.href);
        const columns = getColumnState();
        url.searchParams.set('startDate', appliedStart);
        url.searchParams.set('endDate', appliedEnd);
        url.searchParams.set('includeArchived', document.getElementById('includeArchived').checked ? 'true' : 'false');
        url.searchParams.set('includeAutoGmvInTotal', document.getElementById('includeAutoGmv').checked ? 'true' : 'false');
        url.searchParams.set('showNonKkColumns', columns.nonkk ? 'true' : 'false');
        url.searchParams.set('showKkColumns', columns.kk ? 'true' : 'false');
        url.searchParams.set('showAutoGmvColumns', columns.autogmv ? 'true' : 'false');

        const isColumnPanelOpen = !document.getElementById('columnPanel').hidden;
        url.searchParams.set('openColumnPanel', isColumnPanelOpen ? 'true' : 'false');

        return url.toString();
    }

    function reloadForArchive() {
        window.location.assign(buildReloadUrl());
    }

    function closeAllPanels() {
        setPanel(columnPanel, columnsButton, false);
        setPanel(datePanel, rangeButton, false);
    }

    // click-outside + escape closes floating cards
    // Note: if the clicked element was detached from the DOM during handling (e.g. calendar re-render),
    // closest() returns null - treat that as an inside click so the panel stays open.
    document.addEventListener('click', event => {
        const clicked = event.target instanceof Element && event.target.isConnected ? event.target : null;
        if (!columnPanel.hidden && (!clicked || !clicked.closest('.toolbar-anchor'))) setPanel(columnPanel, columnsButton, false);
        if (!datePanel.hidden && (!clicked || !clicked.closest('.header-anchor'))) setPanel(datePanel, rangeButton, false);
    });
    document.addEventListener('keydown', event => {
        if (event.key === 'Escape') closeAllPanels();
    });

    rangeButton.addEventListener('click', () => {
        const open = datePanel.hidden;
        setPanel(datePanel, rangeButton, open);
        setPanel(columnPanel, columnsButton, false);
        if (open) { pendingStart = appliedStart; pendingEnd = appliedEnd; renderPendingLabel(); renderCalendar(); }
    });
    document.getElementById('closeDatePicker').addEventListener('click', closeAllPanels);
    document.getElementById('cancelDatePicker').addEventListener('click', () => { pendingStart = appliedStart; pendingEnd = appliedEnd; closeAllPanels(); });
    document.getElementById('previousMonth').addEventListener('click', () => { calendarMonth.setMonth(calendarMonth.getMonth() - 1); renderCalendar(); });
    document.getElementById('nextMonth').addEventListener('click', () => { calendarMonth.setMonth(calendarMonth.getMonth() + 1); renderCalendar(); });
    document.getElementById('applyDatePicker').addEventListener('click', () => {
        if (!pendingStart || !pendingEnd) return;
        const form = document.createElement('form');
        form.method = 'get';
        const columns = getColumnState();
        [['startDate', pendingStart], ['endDate', pendingEnd], ['includeArchived', document.getElementById('includeArchived').checked], ['includeAutoGmvInTotal', document.getElementById('includeAutoGmv').checked], ['showNonKkColumns', columns.nonkk], ['showKkColumns', columns.kk], ['showAutoGmvColumns', columns.autogmv]].forEach(([name, value]) => { const input = document.createElement('input'); input.name = name; input.value = value; form.appendChild(input); });
        document.body.appendChild(form);
        form.submit();
    });
    document.querySelectorAll('[data-preset]').forEach(button => button.addEventListener('click', () => {
        const today = new Date();
        const preset = button.dataset.preset;
        const end = new Date(today);
        const start = new Date(today);
        if (preset === 'yesterday') { start.setDate(start.getDate() - 1); end.setDate(end.getDate() - 1); }
        else if (preset !== 'today') start.setDate(start.getDate() - Number(preset) + 1);
        pendingStart = isoDate(start); pendingEnd = isoDate(end); renderPendingLabel(); renderCalendar();
    }));

    columnsButton.addEventListener('click', () => {
        setPanel(columnPanel, columnsButton, columnPanel.hidden);
        setPanel(datePanel, rangeButton, false);
    });
    // Prevent checkbox interactions from closing the panel due to event bubbling.
    document.querySelectorAll('[data-column]').forEach(input => {
        // stop clicks on the input itself from bubbling up to document click handler
        input.addEventListener('click', event => event.stopPropagation());
        // stop clicks on the label (if present) as well
        const lbl = input.closest('label');
        if (lbl) lbl.addEventListener('click', event => event.stopPropagation());
        // handle change while preventing propagation
        input.addEventListener('change', event => {
            event.stopPropagation();
            document.querySelectorAll(`.col-${input.dataset.column}`).forEach(cell => cell.hidden = !input.checked);
        });
    });

    const includeAuto = document.getElementById('includeAutoGmv');
    if (includeAuto) {
        includeAuto.addEventListener('click', event => event.stopPropagation());
        includeAuto.addEventListener('change', event => { event.stopPropagation(); updateTotals(); });
        const lblAuto = includeAuto.closest('label');
        if (lblAuto) lblAuto.addEventListener('click', event => event.stopPropagation());
    }

    const includeArchivedEl = document.getElementById('includeArchived');
    if (includeArchivedEl) {
        includeArchivedEl.addEventListener('click', event => event.stopPropagation());
        includeArchivedEl.addEventListener('change', event => {
            // prevent bubbling so document click-outside doesn't close the panel
            event.stopPropagation();
            // Include Archived is server-side state: the whole Daily Summary (table, Ringkasan,
            // Composition, Pencapaian) is recalculated by DailySummaryService.BuildAsync, so a
            // real navigation is required. buildReloadUrl() preserves startDate, endDate,
            // includeAutoGmvInTotal and column visibility in the new URL.
            reloadForArchive();
        });
        const lblArch = includeArchivedEl.closest('label');
        if (lblArch) lblArch.addEventListener('click', event => event.stopPropagation());
    }

    const composition = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Composition.Select(x => new { percentage = x.Percentage, code = x.Code })));
    const colors = { NON_KK: '#4d9fff', KK: '#e8b83f', AUTO_GMV_LIVE: '#a975e8' };
    const donut = document.getElementById('compositionDonut');
    const totalPercentage = composition.reduce((sum, item) => sum + (Number(item.percentage) || 0), 0);
    if (totalPercentage > 0) {
        let offset = 0;
        const segments = composition.map(item => { const segment = `${colors[item.code] || '#64748b'} ${offset}% ${offset + item.percentage}%`; offset += item.percentage; return segment; });
        donut.style.background = `conic-gradient(${segments.join(',')})`;
    } else {
        donut.classList.add('donut-empty');
    }

    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('openColumnPanel') === 'true') {
        setPanel(columnPanel, columnsButton, true);
    }

    updateTotals();
})();
</script>
}