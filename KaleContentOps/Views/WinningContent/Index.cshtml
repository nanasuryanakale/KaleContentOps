@using KaleContentOps.Services.WinningContent
@model WinningContentData
@{
    ViewData["Title"] = "Winning Content";

    // The controller echoes the effective range; fall back to the model values.
    var startDate = ViewData["StartDate"] as string ?? Model.StartDate.ToString("yyyy-MM-dd");
    var endDate = ViewData["EndDate"] as string ?? Model.EndDate.ToString("yyyy-MM-dd");

    // ============================================================
    // Display helpers (binding/format ONLY - every value comes from
    // the backend model; no analytics is computed here).
    // Number formats follow the approved mockup: dot-grouped integers
    // (id-ID), dot-decimal ER/multiplier (invariant), integer %.
    // NULL analytics render as an em dash placeholder (never as 0).
    // ============================================================
    var IdCulture = System.Globalization.CultureInfo.GetCultureInfo("id-ID");
    var Inv = System.Globalization.CultureInfo.InvariantCulture;
    static string Dash() => "\u2014";
    string Er(object? er) => er is decimal d ? d.ToString("0.0%", Inv) : Dash();
    string Multiplier(object? m) => m is decimal d ? d.ToString("0.0", Inv) + "x" : Dash();
    bool MultPositive(object? m) => m is decimal d && d >= 1m;
    string Views(object? v) => v is long l ? l.ToString("N0", IdCulture) : Dash();
    string MedianViews(object? m) => m is decimal d ? d.ToString("N0", IdCulture) : Dash();
    string Count(object? c) => c is int i ? i.ToString("N0", IdCulture) : Dash();

    WinningContentLeaderboard? LeaderboardFor(string code) =>
        Model.Leaderboards.FirstOrDefault(l => l.ContentTypeCode == code);
    WinningContentCompositionCategory? CategoryFor(string code) =>
        Model.CompositionSummary.Categories.FirstOrDefault(c => c.ContentTypeCode == code);
    WinningContentBelowMedianGroup? BelowMedianFor(string code) =>
        Model.BelowMedian.FirstOrDefault(g => g.ContentTypeCode == code);

    string[] typeCodes = { "NON_KK", "KK", "AUTO_GMV_LIVE" };
    string TypeLabel(string code) => code switch
    {
        "NON_KK" => "Non-KK",
        "KK" => "Keranjang Kuning",
        "AUTO_GMV_LIVE" => "Auto GMV Live",
        _ => code
    };
    string TypeClass(string code) => code switch
    {
        "KK" => "type-kk",
        "AUTO_GMV_LIVE" => "type-autogmv",
        _ => "type-nonkk"
    };

    // Display-only re-orders of the SAME backend Top-N entries (no re-ranking logic:
    // eligibility, rank values and ER order all come from the service):
    // - "Top by Views" block shows the entries by Views DESC (ties -> backend rank).
    // - "Top by Engagement Rate" block keeps the exact backend ER DESC order.
    System.Collections.Generic.IEnumerable<WinningContentLeaderboardEntry> ByViews(WinningContentLeaderboard lb) =>
        lb.Entries.OrderByDescending(e => e.Views ?? long.MinValue).ThenBy(e => e.Rank);

    // Merged below-median list (presentation): all backend entries of all three
    // groups, ordered by Views ASCENDING ("urut dari paling rendah" per mockup).
    var belowAll = Model.BelowMedian
        .SelectMany(g => g.Entries.Select(e => (Entry: e, Group: g)))
        .OrderBy(x => x.Entry.Views ?? long.MinValue)
        .ThenBy(x => x.Entry.Title)
        .ToList();

    // Donut geometry - computed server-side from the EXACT backend percentages.
    // Zero-count categories draw nothing (0-length arc) but STAY in the legend.
    const decimal DonutRadius = 42m;
    var donutCircumference = 2m * (decimal)Math.PI * DonutRadius;
    decimal donutAccumulator = 0m;
    var donutArcs = new List<(string Code, decimal Length, decimal Offset)>();
    foreach (var cat in Model.CompositionSummary.Categories)
    {
        if (cat.Percentage == null || cat.Percentage.Value <= 0m)
        {
            continue;   // No-data or zero-count category: nothing to draw.
        }
        var arcLength = Math.Round(cat.Percentage.Value / 100m * donutCircumference, 2);
        donutArcs.Add((cat.ContentTypeCode, arcLength, donutAccumulator));
        donutAccumulator += arcLength;
    }
    string Svg(decimal value) => value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    // Display text: deterministic integer rounding (half-up) of the EXACT backend
    // percentage; the stored percentages and the donut geometry stay unrounded.
    string Pct(decimal? percentage) => percentage == null
        ? Dash()
        : Math.Round(percentage.Value, 0, MidpointRounding.AwayFromZero).ToString("0", Inv) + "%";
    string SvgFull(decimal? percentage) => percentage == null
        ? Dash()
        : percentage.Value.ToString("0.####", Inv) + "%";

    // Below-median share per type: pure display arithmetic on two backend numbers
    // (Entries.Count / CompositionSummary count). 0/0 renders as a dash, never 0%.
    string BelowSharePct(WinningContentBelowMedianGroup? group)
    {
        var total = CategoryFor(group?.ContentTypeCode ?? "")?.Count ?? 0;
        var below = group?.Entries.Count ?? 0;
        return total == 0 ? Dash() : Math.Round(below * 100m / total, 0, MidpointRounding.AwayFromZero).ToString("0", Inv) + "%";
    }
}

<link rel="stylesheet" href="~/css/winning-content.css" />
<link rel="stylesheet" href="~/css/calendar-popup.css" />

<div class="content-page winning-content-page" data-start="@startDate" data-end="@endDate">

    <!-- ============ A. Header / page title + B. Date range (3E.1 parity, untouched) ============ -->
    <header class="wc-header">
        <div class="wc-title">
            <h1>Winning Content</h1>
            <p>Konten mana yang works, mana yang nggak, dan kenapa - semua angka di bawah dihitung dari periode yang dipilih</p>
        </div>

        <div class="wc-header-anchor">
            <button type="button" class="date-range-button" id="dateRangeButton" aria-expanded="false" aria-controls="datePickerPanel" aria-label="Pilih rentang tanggal laporan">
                <span class="calendar-icon" aria-hidden="true">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <rect x="3" y="5" width="18" height="16" rx="2" stroke="currentColor" stroke-width="1.4" />
                        <path d="M16 3V7" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                        <path d="M8 3V7" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                    </svg>
                </span>
                <strong id="dateRangeLabel">@Model.StartDate.ToString("dd/MM", System.Globalization.CultureInfo.InvariantCulture) - @Model.EndDate.ToString("dd/MM", System.Globalization.CultureInfo.InvariantCulture)</strong>
                <small>GMT+7</small>
            </button>

            <section class="popover-panel date-picker-panel" id="datePickerPanel" hidden>
                <div class="date-picker-topline">
                    <div>
                        <strong id="pendingRangeLabel"></strong>
                        <small>Pilih rentang tanggal laporan</small>
                    </div>
                    <button type="button" class="close-button" id="closeDatePicker" aria-label="Close">×</button>
                </div>
                <div class="date-picker-body">
                    <div class="preset-list" id="presetList">
                        <div class="preset-title">PERIODE CEPAT</div>
                        <button type="button" data-preset="today">Hari Ini</button>
                        <button type="button" data-preset="yesterday">Kemarin</button>
                        <button type="button" data-preset="7">1 Minggu Terakhir</button>
                        <button type="button" data-preset="30">1 Bulan Terakhir</button>
                        <button type="button" data-preset="90">3 Bulan Terakhir</button>
                    </div>
                    <div class="calendar-area">
                        <div class="calendar-toolbar">
                            <button type="button" id="previousMonth" aria-label="Previous month">‹</button>
                            <strong id="calendarTitle"></strong>
                            <button type="button" id="nextMonth" aria-label="Next month">›</button>
                        </div>
                        <div class="calendar-grid" id="calendarGrid"></div>
                    </div>
                </div>
                <div class="date-picker-actions">
                    <div class="date-picker-selected" id="datePickerSelected"></div>
                    <div>
                        <button type="button" class="button-secondary" id="cancelDatePicker">Batal</button>
                        <button type="button" class="button-primary" id="applyDatePicker">Terapkan</button>
                    </div>
                </div>
            </section>
        </div>
    </header>

    <!-- ============ C. Section 1 - Leaderboard per Jenis Konten ============ -->
    <section class="wc-section wc-leaderboards">
        <h2>1. Leaderboard per Jenis Konten &middot; konten mana yang works</h2>
        <p class="wc-section-note">Dipisah per jenis konten (bukan 1 ranking campuran) &mdash; Top by Views beda sama Top by Engagement Rate, karena &ldquo;paling ditonton&rdquo; dan &ldquo;paling ngena&rdquo; itu 2 hal berbeda. Kolom &amp; judul di tabel di bawah ini yang jelasin semua angkanya &mdash; nggak ada lagi istilah yang butuh keterangan tambahan buat dimengerti.</p>

        <div class="wc-leaderboard-grid">
            @foreach (var code in typeCodes)
            {
                var lb = LeaderboardFor(code);
                var typeTotal = CategoryFor(code)?.Count ?? 0;
                <div class="wc-card wc-leaderboard @TypeClass(code)">
                    <div class="wc-leaderboard-head">
                        <h3 class="wc-leaderboard-title"><span class="wc-dot" aria-hidden="true"></span>@TypeLabel(code)</h3>
                        <span class="wc-leaderboard-count">@(Count(typeTotal)) video</span>
                    </div>

                    @if (lb == null || lb.Entries.Count == 0)
                    {
                        <p class="wc-empty">Belum ada konten dengan Engagement Rate pada periode ini.</p>
                    }
                    else
                    {
                        var viewsOrdered = ByViews(lb);
                        var erFirst = lb.Entries.FirstOrDefault(e => e.Rank == 1);
                        var viewsFirst = viewsOrdered.FirstOrDefault();

                        <div class="wc-lb-block">
                            <p class="wc-lb-subtitle">TOP BY VIEWS</p>
                            <table class="wc-lb-table">
                                <thead>
                                    <tr>
                                        <th class="wc-col-video">Video</th>
                                        <th class="wc-col-num">Views</th>
                                        <th class="wc-col-mult">vs rata-rata 30 hari sebelumnya</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var entry in viewsOrdered)
                                    {
                                        <tr class="wc-lb-row">
                                            <td class="wc-col-video">
                                                <span class="wc-lb-ident">
                                                    <span class="wc-lb-rank" aria-label="Peringkat @entry.Rank">@entry.Rank.</span>
                                                    <span class="wc-lb-titles">
                                                        <span class="wc-lb-title" title="@(entry.Title ?? entry.VideoId)">@(entry.Title ?? entry.VideoId)</span>
                                                        @if (entry == viewsFirst)
                                                        {
                                                            <span class="wc-badge">Top Views</span>
                                                        }
                                                        @if (erFirst != null && entry.ContentLogId == erFirst.ContentLogId)
                                                        {
                                                            <span class="wc-badge">Top Engagement</span>
                                                        }
                                                    </span>
                                                </span>
                                            </td>
                                            <td class="wc-col-num wc-num-strong">@Views(entry.Views)</td>
                                            <td class="wc-col-mult @(MultPositive(entry.Multiplier) ? "wc-mult-pos" : "wc-mult-neg")" title="Multiplier vs baseline ER kategori (informasi)">@Multiplier(entry.Multiplier)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="wc-lb-block">
                            <p class="wc-lb-subtitle">TOP BY ENGAGEMENT RATE</p>
                            <table class="wc-lb-table">
                                <thead>
                                    <tr>
                                        <th class="wc-col-video">Video</th>
                                        <th class="wc-col-num">Engagement Rate</th>
                                        <th class="wc-col-mult">vs rata-rata 30 hari sebelumnya</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var entry in lb.Entries)
                                    {
                                        <tr class="wc-lb-row">
                                            <td class="wc-col-video">
                                                <span class="wc-lb-ident">
                                                    <span class="wc-lb-rank" aria-label="Peringkat @entry.Rank">@entry.Rank.</span>
                                                    <span class="wc-lb-titles">
                                                        <span class="wc-lb-title" title="@(entry.Title ?? entry.VideoId)">@(entry.Title ?? entry.VideoId)</span>
                                                        @if (entry.Rank == 1)
                                                        {
                                                            <span class="wc-badge">Top Engagement</span>
                                                        }
                                                    </span>
                                                </span>
                                            </td>
                                            <td class="wc-col-num wc-num-strong">@Er(entry.EngagementRate)</td>
                                            <td class="wc-col-mult @(MultPositive(entry.Multiplier) ? "wc-mult-pos" : "wc-mult-neg")" title="Multiplier vs baseline ER kategori (informasi)">@Multiplier(entry.Multiplier)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            }
        </div>
    </section>

    <!-- ============ D. Section 2 - Distribusi Konten di Bawah Median ============ -->
    <section class="wc-section wc-below-median">
        <h2>2. Distribusi Konten di Bawah Median</h2>
        <p class="wc-section-note">Median itu angka &ldquo;tengah&rdquo; &mdash; kalau semua video jenis yang sama diurutin dari views paling kecil ke paling besar, median adalah angka yang persis di tengah urutan itu. Bedanya sama rata-rata (average): rata-rata gampang keseret tinggi kalau ada 1-2 video yang viral banget, sedangkan median nggak kepengaruhi sama outlier kaya gitu &mdash; jadi lebih jujur buat nunjukkin performa yang &ldquo;typical&rdquo;. &ldquo;Di bawah median&rdquo; di bawah ini artinya video itu views-nya di bawah angka tengah tadi, dibandingin video lain yang jenis kontennya sama. Di volume posting seperti sekarang, sebagian besar konten memang wajar nggak seperform yang paling viral &mdash; ini bukan tanda gagal, cuma gimana algoritma kerja. Yang penting adalah pola: tipe konten apa dan cara produksi apa yang paling banyak nongol di pool &ldquo;di bawah median&rdquo; jenisnya, biar bisa ditarik kesimpulan, bukan cuma lihat 3 video terjelek.</p>

        <div class="wc-card wc-below-panel">
            <table class="wc-below-summary">
                <thead>
                    <tr>
                        <th class="wc-col-video">Jenis Konten</th>
                        <th class="wc-col-num">Di Bawah Median</th>
                        <th class="wc-col-num">Total Konten Jenis Ini</th>
                        <th class="wc-col-num">% Di Bawah Median</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var code in typeCodes)
                    {
                        var group = BelowMedianFor(code);
                        <tr class="wc-below-row">
                            <td class="wc-col-video"><span class="wc-below-type @TypeClass(code)"><span class="wc-dot" aria-hidden="true"></span>@TypeLabel(code)</span></td>
                            <td class="wc-col-num wc-num-strong">@(Count(group?.Entries.Count ?? 0))</td>
                            <td class="wc-col-num">@(Count(CategoryFor(code)?.Count))</td>
                            <td class="wc-col-num wc-num-strong">@BelowSharePct(group)</td>
                        </tr>
                    }
                </tbody>
            </table>

            @{
                var nullMedianTypes = typeCodes
                    .Select(BelowMedianFor)
                    .Where(g => g != null && g.MedianViews == null)
                    .Select(g => g!.ContentTypeCode)
                    .ToList();
            }
            @if (nullMedianTypes.Count > 0)
            {
                <p class="wc-below-median-note">
                    @foreach (var code in nullMedianTypes)
                    {
                        <span>Median kategori belum tersedia untuk @TypeLabel(code) (belum ada Views valid).</span>
                    }
                </p>
            }

            <p class="wc-below-listtitle">DAFTAR LENGKAP &middot; @(Count(belowAll.Count)) VIDEO DI BAWAH MEDIAN (URUT DARI PALING RENDAH)</p>
            @if (belowAll.Count == 0)
            {
                <p class="wc-empty">Tidak ada konten di bawah median.</p>
            }
            else
            {
                <ol class="wc-below-list">
                    @foreach (var (entry, group) in belowAll)
                    {
                        <li class="wc-below-item @TypeClass(entry.ContentTypeCode ?? "")">
                            <span class="wc-dot" aria-hidden="true"></span>
                            <span class="wc-below-name" title="@(entry.Title ?? entry.VideoId)">@(entry.Title ?? entry.VideoId)</span>
                            <span class="wc-below-meta">
                                <span class="wc-below-views" title="Views konten (di bawah median kategori)">@Views(entry.Views) views</span>
                                <span class="wc-below-medianref">median @TypeLabel(entry.ContentTypeCode ?? ""): @MedianViews(group.MedianViews)</span>
                            </span>
                            @if (!string.IsNullOrWhiteSpace(entry.VideoUrl))
                            {
                                <a class="wc-below-link" href="@entry.VideoUrl" target="_blank" rel="noopener" aria-label="Buka video @(entry.Title ?? entry.VideoId)">Video</a>
                            }
                        </li>
                    }
                </ol>
            }
        </div>
    </section>

    <!-- ============ E. Section 3 - Komposisi Konten ============ -->
    <section class="wc-section wc-composition">
        <h2>3. Komposisi Konten</h2>
        <p class="wc-section-note">Proporsi konten per jenis konten (Non-KK/KK/Auto GMV Live), berdasarkan jumlah video &mdash; bukan views.</p>

        @if (!Model.CompositionSummary.HasData)
        {
            <div class="wc-card wc-composition-card">
                <p class="wc-empty">Tidak ada konten pada periode yang dipilih.</p>
            </div>
        }
        else
        {
            <div class="wc-card wc-composition-card">
                <p class="wc-comp-subtitle">KOMPOSISI JENIS KONTEN</p>
                <div class="wc-composition-body">
                    <div class="wc-donut-wrap">
                        <svg class="wc-donut" viewBox="0 0 120 120" role="img" aria-label="Komposisi konten per kategori">
                            <circle class="wc-donut-track" cx="60" cy="60" r="42" />
                            @foreach (var arc in donutArcs)
                            {
                                <circle class="wc-donut-arc @TypeClass(arc.Code)"
                                        cx="60" cy="60" r="42"
                                        stroke-dasharray="@Svg(arc.Length) @Svg(donutCircumference - arc.Length)"
                                        stroke-dashoffset="@Svg(-arc.Offset)"
                                        transform="rotate(-90 60 60)" />
                            }
                        </svg>
                    </div>

                    <!-- Legend: all three locked slots always present, zero-count included. -->
                    <ul class="wc-legend">
                        @foreach (var cat in Model.CompositionSummary.Categories)
                        {
                            <li class="wc-legend-item @TypeClass(cat.ContentTypeCode)">
                                <span class="wc-legend-swatch" aria-hidden="true"></span>
                                <span class="wc-legend-name">@TypeLabel(cat.ContentTypeCode)</span>
                                <span class="wc-legend-pct" title="@SvgFull(cat.Percentage)">@Pct(cat.Percentage)</span>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        }
    </section>

    <!-- ============ Content items binding (selected-period population) ============ -->
    <section class="wc-section wc-items">
        <h2>Konten Periode</h2>
        <p class="wc-section-note">@Model.Items.Count konten pada periode terpilih.</p>

        @if (Model.Items.Count == 0)
        {
            <p class="wc-empty">Tidak ada konten pada periode yang dipilih.</p>
        }
        else
        {
            <div class="wc-table-wrap">
                <table class="wc-table">
                    <thead>
                        <tr>
                            <th>Judul</th>
                            <th>Kategori</th>
                            <th>Views</th>
                            <th>Likes</th>
                            <th>Comments</th>
                            <th>Shares</th>
                            <th>ER</th>
                            <th>Baseline ER</th>
                            <th>Multiplier</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>@(item.Title ?? item.VideoId)</td>
                                <td>@(item.ContentTypeName ?? item.ContentTypeCode ?? Dash())</td>
                                <td>@Views(item.Views)</td>
                                <td>@Views(item.Likes)</td>
                                <td>@Views(item.Comments)</td>
                                <td>@Views(item.Shares)</td>
                                <td>@Er(item.EngagementRate)</td>
                                <td>@Er(item.BaselineEngagementRate)</td>
                                <td>@Multiplier(item.Multiplier)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

@section Scripts {
<script src="~/js/calendar-popup.js"></script>
<script>
(() => {
    // Date-range popover: Daily Summary reference pattern (Phase 3E.1). The shared
    // CalendarPopup module (wwwroot/js/calendar-popup.js, already used by Daily Summary
    // and Targets) renders the two-month grid; this page owns the selection state and
    // submits only startDate/endDate to the existing controller contract. No analytics
    // logic here - the server remains authoritative for the business date range.
    const page = document.querySelector('.winning-content-page');
    const rangeButton = document.getElementById('dateRangeButton');
    const datePanel = document.getElementById('datePickerPanel');
    const appliedStart = page.dataset.start;
    const appliedEnd = page.dataset.end;
    let pendingStart = appliedStart;
    let pendingEnd = appliedEnd;

    const parseDate = value => new Date(`${value}T00:00:00`);
    const formatDate = value => parseDate(value).toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' });

    function setPanel(panel, button, open) {
        panel.hidden = !open;
        button.setAttribute('aria-expanded', open ? 'true' : 'false');
    }

    function renderPendingLabel() {
        const label = document.getElementById('pendingRangeLabel');
        const footer = document.getElementById('datePickerSelected');
        const text = pendingStart && pendingEnd
            ? `${formatDate(pendingStart)} - ${formatDate(pendingEnd)}`
            : pendingStart
                ? `${formatDate(pendingStart)} - ...`
                : 'Pilih rentang tanggal';
        label.textContent = text;
        footer.textContent = pendingStart && pendingEnd ? text : '';
    }

    // Same selection rules as Daily Summary (computeRangeSelection in calendar-popup.js):
    // click = start; second click same/later closes the range; earlier restarts; next click restarts.
    const rangeCalendar = CalendarPopup.createRangeCalendar({
        grid: document.getElementById('calendarGrid'),
        titleEl: document.getElementById('calendarTitle'),
        prevButton: document.getElementById('previousMonth'),
        nextButton: document.getElementById('nextMonth'),
        months: 2,
        initialMonth: appliedStart,
        getSelection: () => ({ start: pendingStart, end: pendingEnd }),
        onSelectionChange: (start, end) => { pendingStart = start; pendingEnd = end; renderPendingLabel(); }
    });
    function renderCalendar() { rangeCalendar.render(); }

    function closeAllPanels() {
        setPanel(datePanel, rangeButton, false);
    }

    // Click-outside + Escape close the panel (same as Daily Summary).
    document.addEventListener('click', event => {
        const clicked = event.target instanceof Element && event.target.isConnected ? event.target : null;
        if (!datePanel.hidden && (!clicked || !clicked.closest('.wc-header-anchor'))) setPanel(datePanel, rangeButton, false);
    });
    document.addEventListener('keydown', event => {
        if (event.key === 'Escape') closeAllPanels();
    });

    rangeButton.addEventListener('click', () => {
        const open = datePanel.hidden;
        setPanel(datePanel, rangeButton, open);
        if (open) { pendingStart = appliedStart; pendingEnd = appliedEnd; renderPendingLabel(); renderCalendar(); }
    });
    document.getElementById('closeDatePicker').addEventListener('click', closeAllPanels);
    document.getElementById('cancelDatePicker').addEventListener('click', () => { pendingStart = appliedStart; pendingEnd = appliedEnd; closeAllPanels(); });
    document.getElementById('applyDatePicker').addEventListener('click', () => {
        if (!pendingStart || !pendingEnd) return;
        // Winning Content takes no other parameters: submit the same contract the old
        // form used - /WinningContent?startDate=yyyy-MM-dd&endDate=yyyy-MM-dd.
        window.location.assign(`/WinningContent?startDate=${encodeURIComponent(pendingStart)}&endDate=${encodeURIComponent(pendingEnd)}`);
    });
    document.querySelectorAll('[data-preset]').forEach(button => button.addEventListener('click', () => {
        const today = new Date();
        const preset = button.dataset.preset;
        const end = new Date(today);
        const start = new Date(today);
        if (preset === 'yesterday') { start.setDate(start.getDate() - 1); end.setDate(end.getDate() - 1); }
        else if (preset !== 'today') start.setDate(start.getDate() - Number(preset) + 1);
        pendingStart = `${start.getFullYear()}-${String(start.getMonth() + 1).padStart(2, '0')}-${String(start.getDate()).padStart(2, '0')}`;
        pendingEnd = `${end.getFullYear()}-${String(end.getMonth() + 1).padStart(2, '0')}-${String(end.getDate()).padStart(2, '0')}`;
        renderPendingLabel(); renderCalendar();
    }));
})();
</script>
}
