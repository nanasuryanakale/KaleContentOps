@model KaleContentOps.Controllers.LoginViewModel
@{
    // Standalone auth page: no sidebar/topbar layout, same visual language
    // (dark blue palette, rounded cards, accent button) as the app shell.
    Layout = null;
    ViewData["Title"] = "Login - KaleContentOps";
}
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body class="auth-body">
    <main class="auth-wrap">
        <div class="auth-card">
            <div class="auth-brand">
                <div class="brand-icon">K</div>
                <div class="brand-text">
                    <div class="title">KALE Content Ops</div>
                    <div class="subtitle">TikTok &middot; Content Log</div>
                </div>
            </div>

            <h1 class="auth-title">Masuk</h1>

            <div asp-validation-summary="All" class="auth-error" role="alert"></div>

            <form asp-action="Login" asp-controller="Account" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" novalidate>
                <div class="auth-field">
                    <label asp-for="Username"></label>
                    <input asp-for="Username" class="auth-input" autocomplete="username" autofocus />
                </div>
                <div class="auth-field">
                    <label asp-for="Password"></label>
                    <input asp-for="Password" class="auth-input" autocomplete="current-password" />
                </div>
                <div class="auth-field auth-remember">
                    <input asp-for="RememberMe" type="checkbox" />
                    <label asp-for="RememberMe"></label>
                </div>
                <button type="submit" class="auth-button">Login</button>
            </form>
        </div>
        <p class="auth-footer">&copy; 2026 - KaleContentOps</p>
    </main>
</body>
</html>
